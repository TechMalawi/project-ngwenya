{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"extends": ["//"],
	"files": {
		"include": ["**/*.js", "**/*.ts", "**/*.json", "**/*.jsonc"],
		"ignore": [
			"**/node_modules/**",
			"**/dist/**",
			"**/build/**",
			"**/.tmp/**",
			"**/public/uploads/**",
			"**/database/**"
		]
	},
	"linter": {
		"rules": {
			"suspicious": {
				"noConsole": "off"
			},
			"style": {
				"useImportType": "error"
			},
			"correctness": {
				"noUnusedVariables": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	}
}

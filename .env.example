# Strapi Backend Configuration
STRAPI_URL=http://localhost:1337

# Cloudflare R2 Configuration (for Strapi backend)
CF_ACCESS_KEY_ID=your_cloudflare_access_key_id
CF_ACCESS_SECRET=your_cloudflare_secret_access_key
CF_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CF_BUCKET=your_bucket_name
CF_PUBLIC_ACCESS_URL=https://your_public_domain.com

# Database Configuration (for Strapi backend)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# JWT Secret (for Strapi backend)
JWT_SECRET=your_jwt_secret_here
APP_KEYS=your_app_key_1,your_app_key_2,your_app_key_3,your_app_key_4
API_TOKEN_SALT=your_api_token_salt
ADMIN_JWT_SECRET=your_admin_jwt_secret
TRANSFER_TOKEN_SALT=your_transfer_token_salt

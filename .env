# Database Configuration
DATABASE_CLIENT=postgres
DATABASE_HOST=strapiDB
DATABASE_PORT=5432
DATABASE_NAME=ngwenya_strapi
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=strapi_secure_password_123

# Strapi Security Keys
# Generate these with: openssl rand -base64 32
JWT_SECRET=ngwenya-jwt-secret-key-please-change-in-production-12345
ADMIN_JWT_SECRET=ngwenya-admin-jwt-secret-key-please-change-in-production-67890

# App Keys - Generate with: openssl rand -base64 32 (comma separated for multiple keys)
APP_KEYS=ngwenya-app-key-1-dev,ngwenya-app-key-2-dev,ngwenya-app-key-3-dev,ngwenya-app-key-4-dev

# Environment
NODE_ENV=development

# Strapi Configuration
HOST=0.0.0.0
PORT=1337

# Additional Configuration
STRAPI_ADMIN_BACKEND_URL=http://localhost:1337
PUBLIC_URL=http://localhost:1336
